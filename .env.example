# Copy this file to .env on the server. Never commit .env or paste keys into chat.
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
DB_PATH=./data/ujai.sqlite

# Optional Google Sign-In (OIDC). Register PUBLIC_ORIGIN as an authorized
# JavaScript origin and PUBLIC_ORIGIN/api/auth/google/callback as a redirect URI.
# Keep the client secret only in this server-side environment; never in public/.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Configure at least one AI provider. The app switches automatically and silently.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible Meta-hosted endpoint; set all three values to enable it.
META_API_KEY=
META_BASE_URL=
META_MODEL=
UJ_AI_PROVIDER_ORDER=gemini,openai,meta

# WebAuthn/passkeys (platform biometrics). Set to your exact production hostname.
WEBAUTHN_RP_ID=localhost

# Password reset SMTP delivery. Leave host/from blank to keep reset delivery disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_TTL_MINUTES=30
