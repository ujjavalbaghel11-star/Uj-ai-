# Copy this file to .env on the server. Never commit .env or paste keys into chat.
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=https://your-domain.example
DB_PATH=./data/ujai.sqlite

# Configure at least one AI provider. The app switches automatically and silently.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: override only for a trusted compatible proxy or local automated tests.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible Meta-hosted endpoint; set all three values to enable it.
META_API_KEY=
META_BASE_URL=
META_MODEL=
UJ_AI_PROVIDER_ORDER=gemini,openai,meta

# WebAuthn/passkeys (platform biometrics). Use your exact production hostname.
WEBAUTHN_RP_ID=your-domain.example

# Optional AI Theme Studio image generation (server-side only)
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: HeyGen text-to-speech for UJ's live spoken replies (keep credentials server-side).
HEYGEN_API_KEY=
HEYGEN_VOICE_ID=da9659970e9d4250be76c3f628565bc7
