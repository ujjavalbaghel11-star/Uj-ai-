    "android:install": "cd android && gradle installDebug"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/android": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
