{
  "name": "uj-ai-cross-platform",
  "version": "3.2.12",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check public/app.js && node --check public/sw.js",
